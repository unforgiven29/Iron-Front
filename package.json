{
  "name": "iron-front",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based combined-arms combat and campaign simulation",
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite --config vite.config.mjs",
    "build": "npm run typecheck && vite build --config vite.config.mjs",
    "preview": "vite preview --config vite.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint game/src game/tests --max-warnings=0",
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "check": "npm run lint && npm run typecheck && npm run validate:schemas && npm run test && npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
