{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iron-front.local/schemas/message-envelope.schema.json",
  "title": "Iron-Front Message Envelope",
  "description": "Shared metadata for commands, events, observations and snapshots. Payload semantics belong to a versioned domain contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["messageId", "contractId", "contractVersion", "producerModuleId", "simulationTick", "simulationTimeSeconds", "kind", "status", "payload"],
  "properties": {
    "messageId": { "type": "string", "minLength": 1 },
    "contractId": { "type": "string", "minLength": 1 },
    "contractVersion": { "type": "integer", "minimum": 1 },
    "producerModuleId": { "type": "string", "minLength": 1 },
    "entityId": { "type": "string" },
    "simulationTick": { "type": "integer", "minimum": 0 },
    "simulationTimeSeconds": { "type": "number", "minimum": 0 },
    "frameId": { "type": "string" },
    "correlationId": { "type": "string" },
    "kind": { "enum": ["command", "event", "observation", "snapshot"] },
    "status": { "enum": ["valid", "stale", "invalid", "unavailable", "estimated", "unknown"] },
    "issuerId": { "type": "string", "minLength": 1 },
    "targetModuleId": { "type": "string", "minLength": 1 },
    "eventType": { "type": "string", "minLength": 1 },
    "sourceId": { "type": "string", "minLength": 1 },
    "acquiredAtTick": { "type": "integer", "minimum": 0 },
    "provenance": { "type": "object" },
    "quality": { "type": "object" },
    "payload": {}
  },
  "oneOf": [
    {
      "title": "Command message",
      "properties": { "kind": { "const": "command" } },
      "required": ["issuerId", "targetModuleId"]
    },
    {
      "title": "Domain event",
      "properties": { "kind": { "const": "event" } },
      "required": ["eventType"]
    },
    {
      "title": "Observation",
      "properties": {
        "kind": { "const": "observation" },
        "payload": {
          "type": "object",
          "required": ["value", "uncertainty"],
          "properties": { "value": {}, "uncertainty": {} },
          "additionalProperties": false
        }
      },
      "required": ["sourceId", "acquiredAtTick"]
    },
    {
      "title": "Immutable snapshot",
      "properties": { "kind": { "const": "snapshot" } }
    }
  ]
}
