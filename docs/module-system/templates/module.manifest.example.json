{
  "manifestSchemaVersion": 1,
  "id": "aircraft.example.variant",
  "kind": "aircraft",
  "name": "Example aircraft variant",
  "version": "0.1.0",
  "apiCompatibility": { "minimum": "0.1.0", "maximumExclusive": null },
  "variant": {
    "family": "Example family",
    "designation": "Exact variant designation",
    "revision": "Configuration/revision identifier",
    "operatorBaseline": "Operator and date/configuration baseline"
  },
  "provides": [
    { "id": "platform.aircraft.definition", "apiVersion": "0.1.0" }
  ],
  "dependencies": [
    { "capabilityId": "physics.rigidbody", "versionRange": "^0.1.0", "optional": false },
    { "capabilityId": "simulation.propulsion", "versionRange": "^0.1.0", "optional": false },
    {
      "capabilityId": "sensor.radar",
      "versionRange": "^0.1.0",
      "optional": true,
      "degradedBehavior": "Only load without radar if the selected exact variant configuration permits that fit."
    }
  ],
  "configuration": [
    { "id": "variant-default", "path": "data/config/variant.json", "schemaId": "aircraft.example.variant-config", "schemaVersion": 1, "required": true }
  ],
  "components": [],
  "assets": [],
  "lifecycle": {
    "initialization": "scenario-load",
    "updateDomain": "fixed-tick",
    "deterministic": true,
    "supportsSaveState": true
  },
  "provenance": {
    "maintainer": "Project maintainers",
    "source": "Populate with actual technical sources.",
    "license": "Populate with applicable license.",
    "notes": "Unknown values remain unknown; do not copy this template unchanged into a runtime package."
  }
}
